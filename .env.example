# Reddit API credentials (strongly recommended).
# Create them at https://www.reddit.com/prefs/apps -> "create another app...":
#   name:         anything, e.g. sentiment-lens
#   type:         script
#   redirect uri: http://localhost:3000
# The client id is the string under the app name; the secret is labelled "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Sent to Reddit on every request. Reddit asks that this identify your app.
REDDIT_USER_AGENT=nodejs:sentiment-lens:v1.0.0 (by /u/your_username)

# Safety cap on how many comments a single run will analyse.
MAX_COMMENTS=1500

# Where the ONNX model weights are cached. Defaults to ./.models
# MODEL_CACHE_DIR=./.models
