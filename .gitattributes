# Normalize line endings so Windows/macOS/Linux collaborators don't churn diffs.
* text=auto eol=lf

# Binary assets: never touch these.
*.ico binary
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
*.onnx binary

# Generated: collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true -diff
components/ui/** linguist-vendored=true
